{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu!flow",
  "version": "0.1.0",
  "identifier": "com.osuflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "osu!flow",
        "width": 500,
        "height": 440,
        "minWidth": 420,
        "minHeight": 340,
        "center": true,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1"
      },
      {
        "label": "overlay",
        "create": false,
        "title": "osu!flow overlay",
        "width": 1280,
        "height": 720,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1"
      },
      {
        "label": "toast",
        "create": false,
        "title": "osu!flow link",
        "width": 380,
        "height": 124,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "focusable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://assets.ppy.sh; media-src https://b.ppy.sh; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "osu!flow",
    "category": "Utility",
    "shortDescription": "Search and download osu! beatmaps without leaving the game",
    "longDescription": "osu!flow sits in the system tray. Press a shortcut in osu! to search for maps, click one, and it is in song select a moment later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}

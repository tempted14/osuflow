{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "osu!flow",
        "width": 560,
        "height": 640,
        "minWidth": 460,
        "minHeight": 340,
        "center": true,
        "transparent": true
      },
      {
        "label": "overlay",
        "create": false,
        "title": "osu!flow overlay",
        "width": 1280,
        "height": 720,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false
      },
      {
        "label": "toast",
        "create": false,
        "title": "osu!flow link",
        "width": 380,
        "height": 124,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "focusable": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ]
  }
}
